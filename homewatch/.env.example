# Required: the TV's reserved/static LAN IPv4 address, without a port.
TV_IP=192.168.1.50

# Persistent host directory for the SSAP pairing key. Change for non-UGREEN hosts.
DATA_DIR=/volume2/docker/omarchytv-homewatch

TARGET_APP_ID=com.omarchytv.home
# com.webos.app.home is the common LG Home id; second id is for model variation.
HOME_APP_IDS=com.webos.app.home,com.webos.launcher
SCREENSAVER_APP_IDS=com.webos.app.screensaver,com.webos.screensaver
# Leave blank for automatic modern WSS (3001) -> legacy WS (3000) selection.
# To force a transport, set e.g. SSAP_URL=wss://192.168.1.50:3001
SSAP_URL=

# Container path is persisted by the bind mount in docker-compose.yml.
STATE_FILE=/data/client-key.json
# Container UID/GID; make DATA_DIR writable by this user/group.
PUID=1000
PGID=1000
